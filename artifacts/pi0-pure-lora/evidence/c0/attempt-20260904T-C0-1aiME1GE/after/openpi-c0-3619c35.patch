--- /dev/null
+++ b/scripts/compute_norm_stats_test.py
@@ -0,0 +1,74 @@
+import pathlib
+import tempfile
+import unittest
+
+from openpi.training import config
+from scripts import compute_norm_stats
+
+
+def _make_config(tmp_path: pathlib.Path, *, assets_dir: str | None, asset_id: str | None):
+    return config.TrainConfig(
+        name="norm-stats-test",
+        assets_base_dir=str(tmp_path / "fallback-assets"),
+        data=config.FakeDataConfig(
+            repo_id="physical-intelligence/libero",
+            assets=config.AssetsConfig(assets_dir=assets_dir, asset_id=asset_id),
+        ),
+    )
+
+
+class ComputeNormStatsPathTest(unittest.TestCase):
+    def setUp(self):
+        self._temporary_directory = tempfile.TemporaryDirectory()
+        self.tmp_path = pathlib.Path(self._temporary_directory.name)
+
+    def tearDown(self):
+        self._temporary_directory.cleanup()
+
+    def test_explicit_local_asset_identity(self):
+        asset_root = self.tmp_path / "canonical-assets"
+        train_config = _make_config(
+            self.tmp_path,
+            assets_dir=str(asset_root),
+            asset_id="libero_pi0_delta_zscore_train1693_v1",
+        )
+
+        self.assertEqual(
+            compute_norm_stats.resolve_output_path(train_config),
+            (asset_root / "libero_pi0_delta_zscore_train1693_v1").resolve(),
+        )
+
+    def test_default_repo_id_layout(self):
+        train_config = _make_config(self.tmp_path, assets_dir=None, asset_id=None)
+
+        self.assertEqual(
+            compute_norm_stats.resolve_output_path(train_config),
+            (pathlib.Path(train_config.assets_dirs) / "physical-intelligence/libero").resolve(),
+        )
+
+    def test_remote_destination_is_rejected(self):
+        train_config = _make_config(
+            self.tmp_path,
+            assets_dir="gs://example-bucket/assets",
+            asset_id="libero",
+        )
+
+        with self.assertRaisesRegex(ValueError, "must be a local path"):
+            compute_norm_stats.resolve_output_path(train_config)
+
+    def test_existing_output_directory_is_rejected(self):
+        output_path = self.tmp_path / "existing-canonical-asset"
+        output_path.mkdir()
+
+        with self.assertRaisesRegex(FileExistsError, "already exists"):
+            compute_norm_stats.ensure_output_path_is_new(output_path)
+
+    def test_missing_output_directory_is_accepted(self):
+        output_path = self.tmp_path / "new-canonical-asset"
+
+        compute_norm_stats.ensure_output_path_is_new(output_path)
+        self.assertFalse(output_path.exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
