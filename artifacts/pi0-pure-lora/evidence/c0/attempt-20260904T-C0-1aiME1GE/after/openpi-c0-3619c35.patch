+                        model_manifest_path=root / "model.json",
+                        golden_manifest_path=root / "golden.json",
+                        adapter_root=root / "adapters",
+                        train_seed=42,
+                    )
+            self.assertFalse((root / "adapters/step-00000100").exists())
+            self.assertFalse((root / "adapters/step-00000100.verified.json").exists())
+
+    def test_bfloat16_parameter_and_optimizer_values(self):
+        with tempfile.TemporaryDirectory() as raw:
+            root = Path(raw)
+            self._inputs(root)
+            manager = mock.Mock()
+            values = np.asarray([1.0, 2.0], dtype=ml_dtypes.bfloat16)
+            state = _state(100, lora_values=values, optimizer_values=values.copy())
+            with mock.patch.object(runtime.checkpoints, "save_state"), mock.patch.object(
+                runtime.checkpoints, "restore_state", return_value=state
+            ):
+                receipt = runtime.save_restore_and_export(
+                    manager,
+                    state,
+                    object(),
+                    save_step=100,
+                    model_manifest_path=root / "model.json",
+                    golden_manifest_path=root / "golden.json",
+                    adapter_root=root / "adapters",
+                    train_seed=42,
+                )
+            self.assertTrue(receipt["all_parameter_values_equal_after_restore"])
+            self.assertTrue(receipt["all_optimizer_values_equal_after_restore"])
+
+
+if __name__ == "__main__":
+    unittest.main()
