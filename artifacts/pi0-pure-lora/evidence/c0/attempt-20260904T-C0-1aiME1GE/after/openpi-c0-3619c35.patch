+                        model_manifest_path=root / "model.json",
+                        golden_manifest_path=root / "golden.json",
+                        adapter_root=root / "adapters",
+                        train_seed=42,
+                    )
+            self.assertFalse((root / "adapters/step-00000100").exists())
+            self.assertFalse((root / "adapters/step-00000100.verified.json").exists())
+
+    def test_optimizer_value_mismatch_blocks_adapter(self):
+        with tempfile.TemporaryDirectory() as raw:
+            root = Path(raw)
+            self._inputs(root)
+            manager = mock.Mock()
+            source = _state(100)
+            restored = _state(100, optimizer_values=np.ones(2, dtype=np.float32))
+            with mock.patch.object(runtime.checkpoints, "save_state"), mock.patch.object(
+                runtime.checkpoints, "restore_state", return_value=restored
+            ):
+                with self.assertRaisesRegex(ValueError, "optimizer value mismatch"):
+                    runtime.save_restore_and_export(
