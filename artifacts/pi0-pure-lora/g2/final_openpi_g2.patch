+def test_pi0_pure_lora_matches_independent_golden_paths():
+    config = _pi0_config.Pi0Config(
+        paligemma_variant="gemma_2b_lora", action_expert_variant="gemma_300m_lora"
+    )
+    abstract_model = nnx.eval_shape(config.create, jax.random.key(0))
+    freeze_filter = config.get_pure_lora_freeze_filter()
+    trainable = nnx.state(abstract_model, nnx.All(nnx.Param, nnx.Not(freeze_filter))).flat_state()
+    frozen = nnx.state(abstract_model, nnx.All(nnx.Param, freeze_filter)).flat_state()
+
+    trainable_paths = {"/".join(str(part) for part in path) for path in trainable}
+    frozen_paths = {"/".join(str(part) for part in path) for path in frozen}
+    assert trainable_paths == _GOLDEN_PURE_LORA_PATHS
+    assert trainable_paths.isdisjoint(frozen_paths)
+    assert len(trainable) == 20
+    assert sum(math.prod(variable.value.shape) for variable in trainable.values()) == 49_987_584
+    assert len(frozen) == 50
+    assert sum(math.prod(variable.value.shape) for variable in frozen.values()) == 3_238_048_528
+
