+    def get_pure_lora_freeze_filter(self) -> nnx.filterlib.Filter:
+        """Freeze every parameter except the independently audited LoRA path set.
+
+        This deliberately does not reuse the broad legacy ``.*lora.*`` filter.
+        The exact paths are valid only for the two audited model variants.
+        """
+        expected_variants = ("gemma_2b_lora", "gemma_300m_lora")
+        actual_variants = (self.paligemma_variant, self.action_expert_variant)
+        if actual_variants != expected_variants:
+            raise ValueError(
+                "pure-LoRA paths are audited only for "
+                f"paligemma={expected_variants[0]!r}, action_expert={expected_variants[1]!r}; "
+                f"got paligemma={actual_variants[0]!r}, action_expert={actual_variants[1]!r}"
+            )
