+@dataclasses.dataclass(frozen=True)
+class PathIn:
+    """NNX filter that matches only an explicit, immutable set of full paths."""
+
+    paths: tuple[tuple[str, ...], ...]
+
+    def __post_init__(self):
+        if not self.paths:
+            raise ValueError("PathIn requires at least one path")
+        if len(self.paths) != len(set(self.paths)):
+            raise ValueError("PathIn paths must be unique")
+        if any(not path or any(not isinstance(part, str) or not part for part in path) for path in self.paths):
+            raise ValueError("PathIn paths must contain non-empty string parts")
+
+    def __call__(self, path: nnx.filterlib.PathParts, x: Any) -> bool:
+        del x
+        return tuple(str(part) for part in path) in self.paths
+
+
 def state_map(state: nnx.State, filter: nnx.filterlib.Filter, fn: Callable[[Any], Any]) -> nnx.State:
